import { useMemo, useState } from "react";
import PageShell from "../../components/common/PageShell";
import { CalendarDays, ChevronLeft, ChevronRight, Clock3, ExternalLink, MapPin, Radio, Ticket, Users } from "lucide-react";

const events = [
  {
    id: "event-1",
    type: "internal",
    mode: "offline",
    title: "Gunpla Build Workshop",
    date: "2026-06-08",
    time: "14:00 - 17:00",
    location: "Gundam Store VN Studio",
    address: "Quận 1, TP.HCM",
    organizer: "Gundam Store VN",
    mapX: "72%",
    mapY: "58%",
    fee: "Miễn phí",
    slots: "24 slots",
    status: "Đang mở đăng ký",
    desc: "Workshop hướng dẫn cắt runner, xử lý nub mark, panel line và hoàn thiện mô hình cho người mới.",
    agenda: ["Giới thiệu tool cơ bản", "Demo xử lý nub mark", "Panel line thực hành", "Q&A cùng builder"],
    cta: "Đăng ký tham gia",
  },
  {
    id: "event-2",
    type: "external",
    mode: "offline",
    title: "Bandai Hobby Showcase",
    date: "2026-06-16",
    time: "10:00 - 20:00",
    location: "Hobby Expo Hall",
    address: "Bangkok, Thailand",
    organizer: "Bandai / Community",
    mapX: "69%",
    mapY: "54%",
    fee: "Theo BTC",
    slots: "Public event",
    status: "Theo dõi thông tin",
    desc: "Triển lãm mô hình, release mới và khu vực trưng bày Gunpla.",
    agenda: ["Showcase sản phẩm mới", "Display booth", "Community meetup"],
    cta: "Xem thông tin",
  },
  {
    id: "event-3",
    type: "internal",
    mode: "livestream",
    title: "Livestream Pre-order Opening",
    date: "2026-07-05",
    time: "20:00 - 21:30",
    location: "Facebook / YouTube Live",
    address: "Online",
    organizer: "Gundam Store VN",
    mapX: "72%",
    mapY: "58%",
    fee: "Miễn phí",
    slots: "Online",
    status: "Sắp diễn ra",
    desc: "Livestream mở preorder, giới thiệu hàng mới và trả lời câu hỏi của collector.",
    agenda: ["Unbox hàng mới", "Mở preorder", "Q&A", "Mini game voucher"],
    cta: "Xem livestream",
  },
];

function tone(event) {
  if (event.mode === "livestream") return "purple";
  if (event.mode === "online") return "cyan";
  if (event.type === "internal") return "blue";
  return "amber";
}

function toneClass(event) {
  const t = tone(event);
  return {
    blue: "bg-blue-50 border-blue-200 text-blue-700",
    amber: "bg-amber-50 border-amber-200 text-amber-700",
    cyan: "bg-cyan-50 border-cyan-200 text-cyan-700",
    purple: "bg-purple-50 border-purple-200 text-purple-700",
  }[t];
}

function label(event) {
  if (event.mode === "livestream") return "Livestream";
  if (event.mode === "online") return "Online";
  if (event.type === "internal") return "Shop tổ chức";
  return "Bên ngoài";
}

export default function EventsPage() {
  const [month, setMonth] = useState(new Date(2026, 5, 1));
  const visibleEvents = useMemo(
    () => events.filter((e) => {
      const d = new Date(e.date);
      return d.getFullYear() === month.getFullYear() && d.getMonth() === month.getMonth();
    }),
    [month]
  );

  const [selected, setSelected] = useState(visibleEvents[0] || events[0]);

  const daysInMonth = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
  const firstDay = new Date(month.getFullYear(), month.getMonth(), 1).getDay();
  const offset = firstDay === 0 ? 6 : firstDay - 1;
  const cells = Array.from({ length: offset + daysInMonth }, (_, i) => i < offset ? null : i - offset + 1);

  function changeMonth(delta) {
    const next = new Date(month.getFullYear(), month.getMonth() + delta, 1);
    setMonth(next);
    const nextEvents = events.filter((e) => {
      const d = new Date(e.date);
      return d.getFullYear() === next.getFullYear() && d.getMonth() === next.getMonth();
    });
    if (nextEvents[0]) setSelected(nextEvents[0]);
  }

  return (
    <PageShell>
      <main className="mx-auto max-w-[1440px] px-4 py-8 lg:px-8">
        <section className="relative overflow-hidden rounded-[36px] bg-slate-950 p-8 text-white shadow-[0_30px_120px_rgba(15,23,42,0.25)]">
          <div className="absolute inset-0 bg-[radial-gradient(circle_at_75%_30%,rgba(37,99,235,0.38),transparent_34%),radial-gradient(circle_at_20%_75%,rgba(168,85,247,0.32),transparent_30%)]" />
          <div className="relative z-10 max-w-3xl">
            <div className="inline-flex rounded-full bg-blue-700 px-4 py-2 text-xs font-black uppercase tracking-[0.25em]">Events Calendar</div>
            <h1 className="mt-5 text-5xl font-black leading-[0.95] md:text-7xl">Lịch sự kiện Gunpla</h1>
            <p className="mt-5 text-base font-semibold leading-8 text-white/75">
              Workshop, contest, expo, online event và livestream cộng đồng.
            </p>
          </div>
        </section>

        <section className="mt-6 flex flex-wrap gap-2">
          <Legend color="bg-blue-500" label="Shop tổ chức" />
          <Legend color="bg-amber-500" label="Sự kiện bên ngoài" />
          <Legend color="bg-cyan-500" label="Online" />
          <Legend color="bg-purple-500" label="Livestream" />
        </section>

        <section className="mt-6 grid gap-6 xl:grid-cols-[1fr_440px]">
          <div className="rounded-[32px] border border-slate-200 bg-white p-5 shadow-sm">
            <div className="mb-5 flex items-center justify-between gap-3">
              <button onClick={() => changeMonth(-1)} className="rounded-full border border-slate-200 p-3 hover:bg-slate-50">
                <ChevronLeft size={20} />
              </button>

              <div className="text-center">
                <div className="text-xs font-black uppercase tracking-[0.22em] text-blue-700">
                  {month.toLocaleString("vi-VN", { month: "long", year: "numeric" })}
                </div>
                <h2 className="mt-1 text-3xl font-black text-slate-950">Calendar Board</h2>
              </div>

              <button onClick={() => changeMonth(1)} className="rounded-full border border-slate-200 p-3 hover:bg-slate-50">
                <ChevronRight size={20} />
              </button>
            </div>

            <div className="grid grid-cols-7 gap-2 text-center">
              {["T2", "T3", "T4", "T5", "T6", "T7", "CN"].map((d) => (
                <div key={d} className="py-2 text-xs font-black text-slate-400">{d}</div>
              ))}

              {cells.map((day, index) => {
                if (!day) return <div key={index} />;

                const hit = visibleEvents.find((e) => Number(e.date.split("-").pop()) === day);
                return (
                  <button
                    key={day}
                    onClick={() => hit && setSelected(hit)}
                    className={`min-h-[92px] rounded-2xl border p-2 text-left transition ${
                      hit ? `${toneClass(hit)} hover:-translate-y-1 hover:shadow-lg` : "border-slate-100 bg-slate-50 text-slate-400"
                    }`}
                  >
                    <div className="text-xs font-black">{day}</div>
                    {hit && (
                      <div className="mt-2 rounded-xl bg-white/80 p-2 text-[11px] font-black leading-4 shadow-sm">
                        {hit.title}
                      </div>
                    )}
                  </button>
                );
              })}
            </div>
          </div>

          <aside className="rounded-[32px] border border-slate-200 bg-white p-5 shadow-sm">
            <span className={`rounded-full border px-3 py-1 text-xs font-black uppercase ${toneClass(selected)}`}>{label(selected)}</span>
            <h2 className="mt-4 text-3xl font-black text-slate-950">{selected.title}</h2>
            <p className="mt-3 text-sm font-semibold leading-7 text-slate-600">{selected.desc}</p>

            <div className="mt-5 grid gap-3">
              <Info icon={Clock3} label="Thời gian" value={`${selected.date} • ${selected.time}`} />
              <Info icon={MapPin} label={selected.location} value={selected.address} />
              <Info icon={Users} label="Organizer" value={selected.organizer} />
              <Info icon={Ticket} label="Thông tin tham gia" value={`${selected.fee} • ${selected.slots} • ${selected.status}`} />
            </div>

            <div className="mt-5 rounded-2xl bg-slate-50 p-4">
              <div className="text-xs font-black uppercase tracking-widest text-slate-400">Agenda</div>
              <div className="mt-3 space-y-2">
                {selected.agenda.map((item) => (
                  <div key={item} className="rounded-xl bg-white px-3 py-2 text-sm font-bold text-slate-700 shadow-sm">
                    {item}
                  </div>
                ))}
              </div>
            </div>

            <div className="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
              {selected.mode === "livestream" ? (
                <div className="flex aspect-video items-center justify-center bg-slate-950 text-white">
                  <div className="text-center">
                    <Radio className="mx-auto mb-3 text-purple-400" size={34} />
                    <div className="text-lg font-black">Livestream Embed Preview</div>
                    <div className="mt-1 text-xs font-semibold text-white/60">Nhúng YouTube/Facebook Live tại đây</div>
                  </div>
                </div>
              ) : (
                <div className="flex aspect-video items-center justify-center bg-gradient-to-br from-blue-50 to-slate-100">
                  <div className="text-center">
                    <MapPin className="mx-auto mb-3 text-blue-700" size={34} />
                    <div className="text-lg font-black text-slate-950">Map Preview</div>
                    <div className="mt-1 text-xs font-semibold text-slate-500">{selected.address}</div>
                  </div>
                </div>
              )}
            </div>

            <div className="mt-5 flex flex-wrap gap-3">
              <button className="rounded-2xl bg-blue-700 px-5 py-3 text-sm font-black text-white shadow-lg shadow-blue-100">{selected.cta}</button>
              <button className="inline-flex items-center gap-2 rounded-2xl border border-slate-200 px-5 py-3 text-sm font-black text-slate-700 hover:bg-slate-50">
                <ExternalLink size={16} />
                Mở bản đồ
              </button>
            </div>
          </aside>
        <section className="mt-8 overflow-hidden rounded-[32px] border border-slate-200 bg-slate-950 p-6 text-white shadow-xl">
          <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
            <div>
              <div className="text-xs font-black uppercase tracking-[0.22em] text-blue-300">
                World Event Map
              </div>
              <h2 className="mt-1 text-3xl font-black">Bản đồ sự kiện</h2>
              <p className="mt-2 text-sm font-semibold text-white/60">
                Các chấm thể hiện khu vực diễn ra sự kiện trong tháng đang chọn.
              </p>
            </div>
          </div>

          <div className="relative min-h-[360px] overflow-hidden rounded-[28px] bg-[radial-gradient(circle_at_30%_30%,rgba(37,99,235,0.35),transparent_30%),radial-gradient(circle_at_75%_45%,rgba(14,165,233,0.25),transparent_30%)]">
            <svg viewBox="0 0 1000 460" className="absolute inset-0 h-full w-full opacity-45">
              <path d="M145 150 C210 80 310 90 350 150 C390 210 300 245 230 230 C160 215 95 205 145 150Z" fill="white" />
              <path d="M390 130 C480 70 590 85 635 145 C690 220 600 260 510 245 C420 230 335 195 390 130Z" fill="white" />
              <path d="M650 165 C740 95 880 125 900 205 C920 290 780 310 700 270 C630 235 590 210 650 165Z" fill="white" />
              <path d="M275 285 C340 250 420 285 410 350 C400 410 300 420 255 370 C220 330 225 305 275 285Z" fill="white" />
              <path d="M720 330 C780 300 865 330 850 385 C835 440 740 425 705 385 C675 352 690 340 720 330Z" fill="white" />
            </svg>

            <div className="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.06)_1px,transparent_1px)] bg-[size:44px_44px]" />

            {visibleEvents.map((event) => (
              <button
                key={event.id}
                onClick={() => setSelected(event)}
                className="group absolute z-20 -translate-x-1/2 -translate-y-1/2"
                style={{ left: event.mapX || "50%", top: event.mapY || "50%" }}
              >
                <span className={`block h-5 w-5 rounded-full ring-8 ${
                  tone(event) === "purple" ? "bg-purple-500 ring-purple-500/20" :
                  tone(event) === "amber" ? "bg-amber-400 ring-amber-400/20" :
                  tone(event) === "cyan" ? "bg-cyan-400 ring-cyan-400/20" :
                  "bg-blue-500 ring-blue-500/20"
                }`} />
                <span className="absolute left-1/2 top-8 hidden w-56 -translate-x-1/2 rounded-2xl bg-white p-3 text-left text-slate-950 shadow-2xl group-hover:block">
                  <span className="text-xs font-black uppercase text-blue-700">{label(event)}</span>
                  <span className="mt-1 block text-sm font-black">{event.title}</span>
                  <span className="mt-1 block text-xs font-semibold text-slate-500">{event.location}</span>
                </span>
              </button>
            ))}
          </div>
        </section>

        <section className="mt-8 rounded-[32px] border border-slate-200 bg-white p-5 shadow-sm">
          <div className="mb-5 flex items-center justify-between">
            <div>
              <div className="text-xs font-black uppercase tracking-[0.22em] text-blue-700">
                Monthly Events
              </div>
              <h2 className="mt-1 text-3xl font-black text-slate-950">
                Sự kiện trong tháng
              </h2>
            </div>

            <span className="rounded-full bg-blue-50 px-3 py-1 text-xs font-black text-blue-700">
              {visibleEvents.length} sự kiện
            </span>
          </div>

          {visibleEvents.length ? (
            <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {visibleEvents.map((event) => (
                <button
                  key={event.id}
                  onClick={() => setSelected(event)}
                  className="group rounded-[26px] border border-slate-200 bg-slate-50 p-5 text-left transition hover:-translate-y-1 hover:border-blue-300 hover:bg-white hover:shadow-xl"
                >
                  <div className="flex items-start justify-between gap-3">
                    <span className={`rounded-full border px-3 py-1 text-xs font-black uppercase ${toneClass(event)}`}>
                      {label(event)}
                    </span>

                    <span className="rounded-2xl bg-slate-950 px-3 py-2 text-xs font-black text-white">
                      {event.date.split("-").reverse().join("/")}
                    </span>
                  </div>

                  <h3 className="mt-4 text-xl font-black text-slate-950 group-hover:text-blue-700">
                    {event.title}
                  </h3>

                  <p className="mt-2 line-clamp-2 text-sm font-semibold leading-6 text-slate-600">
                    {event.desc}
                  </p>

                  <div className="mt-4 grid gap-2 text-sm font-bold text-slate-500">
                    <div>{event.time}</div>
                    <div>{event.location}</div>
                    <div>{event.organizer}</div>
                  </div>
                </button>
              ))}
            </div>
          ) : (
            <div className="rounded-[24px] bg-slate-50 p-8 text-center">
              <div className="text-lg font-black text-slate-950">
                Chưa có sự kiện trong tháng này
              </div>
              <div className="mt-2 text-sm font-semibold text-slate-500">
                Hãy chuyển sang tháng khác hoặc theo dõi cập nhật mới.
              </div>
            </div>
          )}
        </section>
        </section>
      </main>
    </PageShell>
  );
}

function Legend({ color, label }) {
  return (
    <div className="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-black text-slate-600 shadow-sm">
      <span className={`h-2.5 w-2.5 rounded-full ${color}`} />
      {label}
    </div>
  );
}

function Info({ icon: Icon, label, value }) {
  return (
    <div className="rounded-2xl bg-slate-50 p-4">
      <div className="flex items-center gap-2 text-xs font-black uppercase text-slate-400">
        <Icon size={15} />
        {label}
      </div>
      <div className="mt-1 text-sm font-black text-slate-800">{value}</div>
    </div>
  );
}
