import React from "react";
import {
  ArrowRight,
  Clock,
  Heart,
  ShoppingCart,
  Star,
  Zap,
} from "lucide-react";
import { useCms, useLang } from "../../store/CmsStore";

const copy = {
  vi: {
    inStock: "Hàng sẵn",
    preorder: "Pre-order",
    sale: "Sale",
    stock: "Còn",
    sold: "Đã bán",
    addToCart: "Thêm giỏ",
    orderNow: "Đặt ngay",
    preorderNow: "Pre-order",
    eta: "ETA",
    detail: "Chi tiết",
  },
  en: {
    inStock: "In stock",
    preorder: "Pre-order",
    sale: "Sale",
    stock: "Left",
    sold: "Sold",
    addToCart: "Add cart",
    orderNow: "Buy now",
    preorderNow: "Pre-order",
    eta: "ETA",
    detail: "Detail",
  },
};

function money(value) {
  return new Intl.NumberFormat("vi-VN").format(Number(value || 0)) + "₫";
}

function text(value, lang, fallback = "") {
  if (!value) return fallback;
  if (typeof value === "string") return value;
  return value[lang] || value.vi || value.en || fallback;
}

function productName(product, lang) {
  return text(product.name, lang, product.title || "Gundam Model Kit");
}

function statusOf(product) {
  return String(product.status || "").toLowerCase();
}

function isPreorder(product) {
  const status = statusOf(product);
  return Boolean(
    product.preorder?.enabled ||
    status.includes("pre") ||
    status.includes("order")
  );
}

function isSale(product) {
  const status = statusOf(product);
  return Boolean(
    status.includes("sale") ||
    Number(product.oldPrice || 0) > Number(product.price || 0) ||
    product.collections?.includes("sale_products") ||
    product.collections?.includes("sales")
  );
}

function ProductVisual({ tone = "blue", imageUrl }) {
  const toneMap = {
    blue: "from-blue-950 via-blue-600 to-sky-100",
    cyan: "from-cyan-900 via-cyan-500 to-blue-100",
    sky: "from-sky-900 via-sky-500 to-blue-100",
    red: "from-red-950 via-red-500 to-orange-100",
    gold: "from-amber-800 via-yellow-400 to-slate-50",
    slate: "from-slate-950 via-slate-500 to-slate-100",
    violet: "from-violet-950 via-violet-500 to-fuchsia-100",
  };

  if (imageUrl) {
    return (
      <div className="relative h-full overflow-hidden rounded-2xl bg-slate-100">
        <img src={imageUrl} alt="" className="h-full w-full object-cover" />
        <div className="absolute inset-0 bg-gradient-to-tr from-slate-950/20 via-transparent to-white/20" />
      </div>
    );
  }

  return (
    <div className={`relative h-full overflow-hidden rounded-2xl bg-gradient-to-br ${toneMap[tone] || toneMap.blue}`}>
      <div
        className="absolute inset-0 opacity-40"
        style={{
          backgroundImage:
            "linear-gradient(rgba(255,255,255,0.38) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.38) 1px, transparent 1px)",
          backgroundSize: "18px 18px",
        }}
      />
      <div className="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-white/40 blur-2xl" />
      <div className="absolute bottom-2 left-4 right-4 h-7 rounded-full bg-black/20 blur-xl" />
      <div className="absolute left-1/2 top-1/2 h-24 w-16 -translate-x-1/2 -translate-y-1/2 rotate-[-8deg] rounded-2xl bg-white/90 shadow-2xl">
        <div className="absolute left-1/2 top-3 h-8 w-8 -translate-x-1/2 rounded-lg bg-red-500" />
        <div className="absolute bottom-3 left-2 h-10 w-3 rounded-full bg-slate-950" />
        <div className="absolute bottom-3 right-2 h-10 w-3 rounded-full bg-slate-950" />
        <div className="absolute -left-7 top-10 h-3 w-14 -rotate-45 rounded-full bg-yellow-300" />
        <div className="absolute -right-7 top-10 h-3 w-14 rotate-45 rounded-full bg-cyan-300" />
      </div>
    </div>
  );
}

export default function ProductCard({ product, view = "grid" }) {
  const { actions } = useCms();
  const [lang] = useLang();
  const t = copy[lang] || copy.vi;

  const preorder = isPreorder(product);
  const sale = isSale(product);
  const price = Number(product.price || product.deposit || 0);
  const oldPrice = Number(product.oldPrice || 0);
  const productUrl = `/product/${product.slug || product.id}`;

  const openProduct = () => {
    window.location.href = productUrl;
  };

  const stopClick = (event) => {
    event.stopPropagation();
  };

  const addCart = (event) => {
    stopClick(event);
    actions.addToCart(product.id, 1);
  };

  if (view === "list") {
    return (
      <article
        onClick={openProduct}
        role="link"
        tabIndex={0}
        onKeyDown={(event) => {
          if (event.key === "Enter") openProduct();
        }}
        className="group cursor-pointer overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-2xl hover:shadow-blue-100/70"
      >
        <div className="grid gap-4 md:grid-cols-[190px_1fr_210px] md:items-center">
          <div className="relative h-44 overflow-hidden rounded-2xl">
            <ProductVisual imageUrl={product.imageUrl || product.images?.[0]} tone={product.tone || product.color || "blue"} />
          </div>

          <div>
            <div className="flex flex-wrap gap-2">
              <span className={`rounded-lg px-2.5 py-1 text-[10px] font-black uppercase text-white shadow-sm ${
                preorder ? "bg-violet-600" : sale ? "bg-red-600" : "bg-emerald-600"
              }`}>
                {preorder ? t.preorder : sale ? t.sale : t.inStock}
              </span>
              <span className="rounded-lg border border-blue-100 bg-blue-50 px-2.5 py-1 text-[10px] font-black text-blue-700">
                {product.grade || "Gunpla"}
              </span>
              <span className="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-black text-slate-600">
                {product.scale || product.brand || "Bandai"}
              </span>
            </div>

            <h3 className="mt-3 text-lg font-black text-slate-950 transition group-hover:text-blue-700">
              {productName(product, lang)}
            </h3>

            <div className="mt-2 flex flex-wrap items-center gap-4 text-xs font-bold text-slate-500">
              <span className="flex items-center gap-1 rounded-full bg-amber-50 px-2 py-1 text-amber-500">
                <Star size={13} fill="currentColor" /> {product.rating || "4.9"}
              </span>
              <span>{t.sold}: {product.sold || 0}</span>
              {preorder ? (
                <span className="font-black text-violet-700">{t.eta}: {product.preorder?.eta || product.eta || "TBD"}</span>
              ) : (
                <span className="font-black text-emerald-700">{t.stock}: {product.stock ?? 0}</span>
              )}
            </div>
          </div>

          <div className="md:text-right">
            <div className="text-2xl font-black text-blue-700">{money(price)}</div>
            {oldPrice > price && (
              <div className="text-sm font-bold text-slate-400 line-through">{money(oldPrice)}</div>
            )}

            <div className="mt-4 grid gap-2">
              {preorder ? (
                <a
                  href={productUrl}
                  onClick={stopClick}
                  className="rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 px-4 py-3 text-center text-sm font-black text-white shadow-xl shadow-violet-300/60 transition hover:scale-[1.02] hover:from-violet-700 hover:to-fuchsia-700"
                >
                  <Clock size={15} className="mr-1 inline" />
                  {t.preorderNow}
                </a>
              ) : (
                <>
                  <button
                    onClick={addCart}
                    className="rounded-2xl bg-white px-4 py-3 text-sm font-black text-blue-700 shadow-lg ring-1 ring-blue-100 transition hover:scale-[1.02] hover:bg-blue-50"
                  >
                    <ShoppingCart size={15} className="mr-1 inline" />
                    {t.addToCart}
                  </button>
                  <a
                    href={productUrl}
                    onClick={stopClick}
                    className="rounded-2xl bg-gradient-to-r from-blue-700 to-cyan-600 px-4 py-3 text-center text-sm font-black text-white shadow-xl shadow-blue-300/60 transition hover:scale-[1.02] hover:from-blue-800 hover:to-cyan-700"
                  >
                    <Zap size={15} className="mr-1 inline" />
                    {t.orderNow}
                  </a>
                </>
              )}
            </div>
          </div>
        </div>
      </article>
    );
  }

  return (
    <article
      onClick={openProduct}
      role="link"
      tabIndex={0}
      onKeyDown={(event) => {
        if (event.key === "Enter") openProduct();
      }}
      className="group cursor-pointer overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-blue-300 hover:shadow-2xl hover:shadow-blue-100/70"
    >
      <div className="relative h-52 overflow-hidden">
        <ProductVisual imageUrl={product.imageUrl || product.images?.[0]} tone={product.tone || product.color || "blue"} />

        <div className="absolute inset-0 bg-gradient-to-t from-slate-950/35 via-transparent to-transparent opacity-0 transition group-hover:opacity-100" />

        <div className={`absolute left-3 top-3 rounded-lg px-2.5 py-1 text-[10px] font-black uppercase text-white shadow-md ${
          preorder ? "bg-violet-600" : sale ? "bg-red-600" : "bg-emerald-600"
        }`}>
          {preorder ? t.preorder : sale ? t.sale : t.inStock}
        </div>

        <div className="absolute right-3 top-3 rounded-lg bg-white px-2.5 py-1 text-[10px] font-black text-blue-700 shadow-sm">
          {product.grade || product.scale || "HG"}
        </div>

        <button
          onClick={stopClick}
          className="absolute right-3 top-12 rounded-xl bg-white/95 p-2 text-slate-400 shadow-md transition hover:scale-110 hover:text-red-600"
          aria-label="Wishlist"
        >
          <Heart size={16} />
        </button>

        <div className="absolute inset-x-3 bottom-3 translate-y-5 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
          {preorder ? (
            <a
              href={productUrl}
              onClick={stopClick}
              className="block rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600 px-3 py-3 text-center text-xs font-black text-white shadow-xl shadow-violet-300/60 transition hover:scale-[1.02] hover:from-violet-700 hover:to-fuchsia-700"
            >
              <Clock size={14} className="mr-1 inline" />
              {t.preorderNow}
              {product.preorder?.eta || product.eta ? ` • ${t.eta}: ${product.preorder?.eta || product.eta}` : ""}
            </a>
          ) : (
            <div className="grid grid-cols-2 gap-2">
              <button
                onClick={addCart}
                className="rounded-xl bg-white px-2 py-2.5 text-[11px] font-black text-blue-700 shadow-xl ring-1 ring-blue-100 transition hover:scale-[1.03] hover:bg-blue-50"
              >
                <ShoppingCart size={13} className="mr-1 inline" />
                {t.addToCart}
              </button>

              <a
                href={productUrl}
                onClick={stopClick}
                className="rounded-xl bg-gradient-to-r from-blue-700 to-cyan-600 px-2 py-2.5 text-center text-[11px] font-black text-white shadow-xl shadow-blue-300/60 transition hover:scale-[1.03] hover:from-blue-800 hover:to-cyan-700"
              >
                <Zap size={13} className="mr-1 inline" />
                {t.orderNow}
              </a>
            </div>
          )}
        </div>
      </div>

      <div className="p-4">
        <div className="line-clamp-2 min-h-11 text-sm font-black leading-5 text-slate-950 transition group-hover:text-blue-700">
          {productName(product, lang)}
        </div>

        <div className="mt-2 flex items-center justify-between gap-2 text-xs font-bold text-slate-500">
          <span>{product.scale || "1/144"}</span>
          <span className={preorder ? "text-violet-700" : "text-emerald-700"}>
            {preorder ? t.preorder : `${t.stock} ${product.stock ?? 0}`}
          </span>
        </div>

        <div className="mt-3 flex items-end justify-between gap-2">
          <div>
            <div className="text-lg font-black text-blue-700">{money(price)}</div>
            {oldPrice > price && (
              <div className="text-xs font-bold text-slate-400 line-through">{money(oldPrice)}</div>
            )}
          </div>

          <div className="flex items-center gap-1 rounded-full bg-amber-50 px-2 py-1 text-[11px] font-black text-amber-500">
            <Star size={12} fill="currentColor" />
            {product.rating || "4.9"}
          </div>
        </div>

        <div className="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
          <span className="text-[10px] font-black uppercase tracking-wide text-slate-400">
            {preorder ? "Pre-order item" : "Ready stock"}
          </span>
          <span className="inline-flex items-center gap-1 text-[10px] font-black text-blue-700 opacity-0 transition group-hover:opacity-100">
            {t.detail} <ArrowRight size={12} />
          </span>
        </div>
      </div>
    </article>
  );
}
