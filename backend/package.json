{
  "name": "gundam-store-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node scripts/repairProductReviewSchema.mjs && npx prisma validate",
    "prisma:generate": "node scripts/repairProductReviewSchema.mjs && prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "seed:catalog": "node prisma/seedCatalog.js",
    "schema:repair-reviews": "node scripts/repairProductReviewSchema.mjs",
    "cleanup:banners": "node scripts/cleanupBannerPerformance.mjs",
    "images:audit": "node scripts/auditImages.mjs",
    "smoke:admin": "node scripts/smokeAdminApis.js",
    "smoke:stock-race": "node scripts/smokeStockRace.mjs",
    "seed:customer": "node scripts/seedCustomerAccount.mjs",
    "smoke:customer-order": "node scripts/smokeCustomerOrderFlow.mjs",
    "smoke:cancel-restore": "node scripts/smokeCancelOrderRestoreStock.mjs",
    "smoke:address-book": "node scripts/smokeAddressBook.mjs",
    "smoke:payment-workflow": "node scripts/smokePaymentWorkflow.mjs",
    "smoke:admin-order-operation": "node scripts/smokeAdminOrderOperation.mjs",
    "check:env": "node scripts/checkProductionEnv.mjs",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "smoke:readiness": "node scripts/smokeProductionReadiness.mjs",
    "seed:demo": "SEED_MODE=demo ALLOW_DEMO_SEED=true node prisma/seed.js",
    "seed:production": "SEED_MODE=production node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.46.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.11",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.0.0"
  }
}
