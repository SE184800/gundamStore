generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
  WALLET
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  FAILED
  RETURNED
}

enum InventoryLogType {
  IMPORT
  EXPORT
  RESERVE
  RESTORE
  ADJUST
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  active       Boolean    @default(true)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]

  profile       UserProfile?
  addresses     UserAddress[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  phone      String?
  birthday   DateTime?
  gender     String?
  avatarUrl  String?
  note       String?
  city       String?
  district   String?
  ward       String?
  address    String?
  postalCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAddress {
  id          String  @id @default(cuid())
  userId      String
  label       String  @default("Nhà riêng")
  receiver    String
  phone       String
  address     String
  city        String?
  district    String?
  ward        String?
  postalCode  String?
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ProductCategory {
  id          String  @id @default(cuid())
  code        String  @unique
  slug        String  @unique
  nameVi      String
  nameEn      String?
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  note        String?
  active      Boolean @default(true)

  purchaseReceipts PurchaseReceipt[]
  products         Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductGroup {
  id          String  @id @default(cuid())
  code        String  @unique
  slug        String  @unique
  nameVi      String
  nameEn      String?
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  products ProductGroupItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductGroupItem {
  id        String  @id @default(cuid())
  productId String
  groupId   String
  sortOrder Int     @default(0)
  featured  Boolean @default(false)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, groupId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  type      String  @default("gallery")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPrice {
  id             String    @id @default(cuid())
  productId      String
  price          Int
  oldPrice       Int       @default(0)
  source         String    @default("AVG_COST")
  suggestedPrice Int       @default(0)
  marginPercent  Float     @default(0)
  baseCost       Int       @default(0)
  startDate      DateTime
  endDate        DateTime?
  active         Boolean   @default(true)
  note           String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, active, startDate, endDate])
}

model Product {
  id            String  @id @default(cuid())
  sku           String  @unique
  slug          String  @unique
  barcode       String?
  nameVi        String
  nameEn        String?
  shortVi       String?
  shortEn       String?
  description   String?
  descriptionEn String?

  price            Int
  avgCost          Int     @default(0)
  lastPurchaseCost Int     @default(0)
  oldPrice         Int     @default(0)
  stock            Int     @default(0)
  status           String  @default("inStock")
  active           Boolean @default(true)

  imageUrl String?
  brand    String?
  grade    String?
  scale    String?
  tone     String?
  sold     Int     @default(0)
  rating   Float   @default(0)

  specs    Json?
  boxItems Json?
  media    Json?

  categoryId String?
  supplierId String?

  category   ProductCategory?   @relation(fields: [categoryId], references: [id])
  supplier   Supplier?          @relation(fields: [supplierId], references: [id])
  images     ProductImage[]
  groupItems ProductGroupItem[]

  orderItems            OrderItem[]
  purchaseReceiptItems  PurchaseReceiptItem[]
  inventoryTransactions InventoryTransaction[]
  stockAdjustments      StockAdjustment[]
  stockCountItems       StockCountItem[]
  inventoryLogs         InventoryLog[]
  prices                ProductPrice[]
  promotionProducts     PromotionProduct[]
  wishlistItems        WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String  @id @default(cuid())
  orderNo         String  @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String

  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)

  subtotal    Int @default(0)
  shippingFee Int @default(0)
  discount    Int @default(0)
  total       Int @default(0)

  note      String?
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  sku       String
  name      String
  price     Int
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  status    PaymentStatus @default(UNPAID)
  amount    Int
  reference String?
  note      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String?
  trackingCode   String?
  shippingMethod String?
  status         ShipmentStatus @default(PENDING)
  fee            Int            @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryLog {
  id          String           @id @default(cuid())
  productId   String
  type        InventoryLogType
  quantity    Int
  beforeStock Int
  afterStock  Int
  reason      String?
  refType     String?
  refId       String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  orderId  String?
  action   String
  entity   String
  entityId String?
  metadata Json?

  actor User?  @relation(fields: [actorId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model PurchaseReceipt {
  id          String   @id @default(cuid())
  receiptNo   String   @unique
  supplierId  String?
  receiptDate DateTime @default(now())
  status      String   @default("POSTED")
  note        String?
  totalAmount Int      @default(0)

  supplier Supplier?             @relation(fields: [supplierId], references: [id])
  items    PurchaseReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseReceiptItem {
  id         String @id @default(cuid())
  receiptId  String
  productId  String
  quantity   Int
  unitCost   Int
  lineAmount Int

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryTransaction {
  id            String  @id @default(cuid())
  productId     String
  type          String
  quantity      Int
  unitCost      Int     @default(0)
  beforeStock   Int
  afterStock    Int
  avgCostBefore Int     @default(0)
  avgCostAfter  Int     @default(0)
  refType       String?
  refId         String?
  note          String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, type, createdAt])
}

model StockAdjustment {
  id            String  @id @default(cuid())
  adjustmentNo  String  @unique
  productId     String
  quantityDelta Int
  beforeStock   Int
  afterStock    Int
  reason        String
  note          String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockCount {
  id        String           @id @default(cuid())
  countNo   String           @unique
  countDate DateTime         @default(now())
  status    String           @default("POSTED")
  note      String?
  items     StockCountItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockCountItem {
  id           String  @id @default(cuid())
  countId      String
  productId    String
  systemStock  Int
  countedStock Int
  difference   Int
  reason       String?

  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id        String    @id @default(cuid())
  code      String    @unique
  nameVi    String
  nameEn    String?
  type      String    @default("PERCENT")
  value     Int
  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)
  priority  Int       @default(0)
  note      String?

  products PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startDate, endDate, priority])
}

model PromotionProduct {
  id          String @id @default(cuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promotionId, productId])
}
