generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  CARD
  WALLET
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPING
  DELIVERED
  FAILED
  RETURNED
}

enum InventoryLogType {
  IMPORT
  EXPORT
  RESERVE
  RESTORE
  ADJUST
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  active       Boolean    @default(true)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]

  profile            UserProfile?
  addresses          UserAddress[]
  wishlistItems      WishlistItem[]
  orders             Order[]
  voucherRedemptions VoucherRedemption[]
  complaintTickets   ComplaintTicket[]
  productReviews     ProductReview[]
  customerNotes      CustomerNote[]
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  phone      String?
  birthday   DateTime?
  gender     String?
  avatarUrl  String?
  note       String?
  city       String?
  district   String?
  ward       String?
  address    String?
  postalCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAddress {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Nhà riêng")
  receiver   String
  phone      String
  address    String
  city       String?
  district   String?
  ward       String?
  postalCode String?
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isDefault])
}

model WishlistItem {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model CustomerNote {
  id          String  @id @default(cuid())
  customerId  String?
  customerKey String
  type        String  @default("NOTE")
  content     String
  createdById String?

  customer User? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?

  @@index([customerId, createdAt])
  @@index([customerKey, createdAt])
  @@index([type, createdAt])
}

model ProductCategory {
  id          String  @id @default(cuid())
  code        String  @unique
  slug        String  @unique
  nameVi      String
  nameEn      String?
  description String?
  imageUrl    String?
  icon        String?
  altText     String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  note        String?
  active      Boolean @default(true)

  purchaseReceipts PurchaseReceipt[]
  products         Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductGroup {
  id          String  @id @default(cuid())
  code        String  @unique
  slug        String  @unique
  nameVi      String
  nameEn      String?
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  products ProductGroupItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductGroupItem {
  id        String  @id @default(cuid())
  productId String
  groupId   String
  sortOrder Int     @default(0)
  featured  Boolean @default(false)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, groupId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  type      String  @default("gallery")
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPrice {
  id             String    @id @default(cuid())
  productId      String
  price          Int
  oldPrice       Int       @default(0)
  source         String    @default("AVG_COST")
  suggestedPrice Int       @default(0)
  marginPercent  Float     @default(0)
  baseCost       Int       @default(0)
  startDate      DateTime
  endDate        DateTime?
  active         Boolean   @default(true)
  note           String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, active, startDate, endDate])
}

model Product {
  id            String  @id @default(cuid())
  sku           String  @unique
  slug          String  @unique
  barcode       String?
  nameVi        String
  nameEn        String?
  shortVi       String?
  shortEn       String?
  description   String?
  descriptionEn String?

  price            Int
  avgCost          Int     @default(0)
  lastPurchaseCost Int     @default(0)
  oldPrice         Int     @default(0)
  stock            Int     @default(0)
  status           String  @default("inStock")
  active           Boolean @default(true)

  imageUrl String?
  brand    String?
  grade    String?
  scale    String?
  tone     String?
  sold     Int     @default(0)
  rating   Float   @default(0)

  specs    Json?
  boxItems Json?
  media    Json?

  categoryId String?
  supplierId String?

  category   ProductCategory?   @relation(fields: [categoryId], references: [id])
  supplier   Supplier?          @relation(fields: [supplierId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  groupItems ProductGroupItem[]

  orderItems            OrderItem[]
  purchaseReceiptItems  PurchaseReceiptItem[]
  inventoryTransactions InventoryTransaction[]
  stockAdjustments      StockAdjustment[]
  stockCountItems       StockCountItem[]
  inventoryLogs         InventoryLog[]
  prices                ProductPrice[]
  promotionProducts     PromotionProduct[]
  wishlistItems         WishlistItem[]
  restockAlerts         RestockAlert[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productReviews ProductReview[]
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  sku          String  @unique
  barcode      String?
  nameVi       String
  nameEn       String?
  option1Name  String?
  option1Value String?
  option2Name  String?
  option2Value String?
  price        Int     @default(0)
  oldPrice     Int     @default(0)
  stock        Int     @default(0)
  imageUrl     String?
  active       Boolean @default(true)
  status       String  @default("inStock")
  sortOrder    Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, active, sortOrder])
  @@index([sku, active])
}

model ComplaintTicket {
  id             String    @id @default(cuid())
  ticketNo       String    @unique
  orderId        String?
  customerId     String?
  customerName   String
  customerPhone  String?
  customerEmail  String?
  type           String    @default("COMPLAINT")
  issue          String
  description    String
  priority       String    @default("MEDIUM")
  status         String    @default("NEW")
  resolution     String?
  refundAmount   Int       @default(0)
  refundStatus   String    @default("NONE")
  returnTracking String?
  images         Json?
  assignedToId   String?
  closedAt       DateTime?

  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer User?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  comments ComplaintTicketComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority, createdAt])
  @@index([orderId])
  @@index([customerId])
  @@index([ticketNo])
}

model ComplaintTicketComment {
  id        String  @id @default(cuid())
  ticketId  String
  actorId   String?
  actorName String?
  type      String  @default("COMMENT")
  content   String

  ticket ComplaintTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model ProductReview {
  id               String    @id @default(cuid())
  productId        String
  userId           String?
  orderNo          String?
  customerName     String
  customerEmail    String?
  rating           Int
  title            String?
  content          String
  images           Json?
  status           String    @default("PENDING")
  verifiedPurchase Boolean   @default(false)
  helpfulCount     Int       @default(0)
  adminReply       String?
  moderatedById    String?
  moderatedAt      DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?

  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Voucher {
  id                    String    @id @default(cuid())
  code                  String    @unique
  nameVi                String
  nameEn                String?
  description           String?
  type                  String    @default("PERCENT")
  value                 Int       @default(0)
  maxDiscount           Int       @default(0)
  minOrder              Int       @default(0)
  usageLimit            Int       @default(0)
  usageLimitPerCustomer Int       @default(0)
  usedCount             Int       @default(0)
  startDate             DateTime
  endDate               DateTime?
  active                Boolean   @default(true)
  stackable             Boolean   @default(false)
  firstOrderOnly        Boolean   @default(false)
  productIds            Json?
  categoryIds           Json?
  note                  String?

  orders      Order[]
  redemptions VoucherRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code, active, startDate, endDate])
}

model VoucherRedemption {
  id               String  @id @default(cuid())
  voucherId        String
  orderId          String
  customerId       String?
  code             String
  discount         Int     @default(0)
  shippingDiscount Int     @default(0)

  voucher  Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([voucherId, customerId])
  @@index([orderId])
  @@index([code])
}

model Order {
  id              String  @id @default(cuid())
  orderNo         String  @unique
  customerId      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String

  customer User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  voucher  Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)

  subtotal         Int     @default(0)
  shippingFee      Int     @default(0)
  discount         Int     @default(0)
  shippingDiscount Int     @default(0)
  voucherCode      String?
  voucherId        String?
  total            Int     @default(0)

  note String?

  cancelledAt     DateTime?
  cancelReason    String?
  cancelNote      String?
  cancelledById   String?
  stockRestoredAt DateTime?

  items              OrderItem[]
  payments           Payment[]
  shipments          Shipment[]
  auditLogs          AuditLog[]
  voucherRedemptions VoucherRedemption[]
  complaintTickets   ComplaintTicket[]
  productReviews     ProductReview[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customerNotes CustomerNote[]

  @@index([customerId, createdAt])
  @@index([status, stockRestoredAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  sku            String
  variantSku     String?
  name           String
  variantName    String?
  variantOptions Json?
  price          Int
  quantity       Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  status    PaymentStatus @default(UNPAID)
  amount    Int
  reference String?
  note      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  carrier        String?
  trackingCode   String?
  shippingMethod String?
  status         ShipmentStatus @default(PENDING)
  fee            Int            @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryLog {
  id          String           @id @default(cuid())
  productId   String
  type        InventoryLogType
  quantity    Int
  beforeStock Int
  afterStock  Int
  reason      String?
  refType     String?
  refId       String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  orderId  String?
  action   String
  entity   String
  entityId String?
  metadata Json?

  actor User?  @relation(fields: [actorId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([orderId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model PurchaseReceipt {
  id          String   @id @default(cuid())
  receiptNo   String   @unique
  supplierId  String?
  receiptDate DateTime @default(now())
  status      String   @default("POSTED")
  note        String?
  totalAmount Int      @default(0)

  supplier Supplier?             @relation(fields: [supplierId], references: [id])
  items    PurchaseReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseReceiptItem {
  id         String @id @default(cuid())
  receiptId  String
  productId  String
  quantity   Int
  unitCost   Int
  lineAmount Int

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryTransaction {
  id            String  @id @default(cuid())
  productId     String
  type          String
  quantity      Int
  unitCost      Int     @default(0)
  beforeStock   Int
  afterStock    Int
  avgCostBefore Int     @default(0)
  avgCostAfter  Int     @default(0)
  refType       String?
  refId         String?
  note          String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, type, createdAt])
}

model StockAdjustment {
  id            String  @id @default(cuid())
  adjustmentNo  String  @unique
  productId     String
  quantityDelta Int
  beforeStock   Int
  afterStock    Int
  reason        String
  note          String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockCount {
  id        String           @id @default(cuid())
  countNo   String           @unique
  countDate DateTime         @default(now())
  status    String           @default("POSTED")
  note      String?
  items     StockCountItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockCountItem {
  id           String  @id @default(cuid())
  countId      String
  productId    String
  systemStock  Int
  countedStock Int
  difference   Int
  reason       String?

  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id        String    @id @default(cuid())
  code      String    @unique
  nameVi    String
  nameEn    String?
  type      String    @default("PERCENT")
  value     Int
  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)
  priority  Int       @default(0)
  note      String?

  products PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startDate, endDate, priority])
}

model PromotionProduct {
  id          String @id @default(cuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([promotionId, productId])
}

model RestockAlert {
  id          String    @id @default(cuid())
  productId   String
  productName String
  productSlug String?
  sku         String?
  grade       String?
  scale       String?
  name        String
  phone       String
  note        String?
  status      String    @default("PENDING")
  notifiedAt  DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([productId, phone, status])
}

model Banner {
  id            String  @id @default(cuid())
  titleInternal String
  altText       String?
  placement     String  @default("Homepage Hero")
  mediaType     String  @default("image")

  mainImage    String
  imageUrl     String?
  mobileImage  String?
  tabletImage  String?
  desktopImage String?
  videoUrl     String?

  ctaUrl   String  @default("/shop")
  status   String  @default("Draft")
  active   Boolean @default(true)
  priority Int     @default(1)
  fitMode  String  @default("cover")

  legacyText Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, status, active, priority])
}

model HeroSetting {
  id         String  @id
  layout     String  @default("v2")
  autoplay   Boolean @default(true)
  interval   Int     @default(4500)
  maxBanners Int     @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
